# Copy this file to .env and fill in your keys. Never commit .env.
GOOGLE_API_KEY=paste-your-gemini-key-here
# Optional: trace every call in LangSmith
LANGSMITH_API_KEY=paste-your-langsmith-key-here
# Optional: Gemini model name (default: gemini-3.5-flash-lite)
MODEL_NAME=gemini-3.5-flash-lite
# Optional: try Azure OpenAI first
AZURE_OPENAI_API_KEY=
